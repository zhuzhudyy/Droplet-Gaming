    role: commander
    text: "\u8230\u6865\u53D7\u88AD\uFF01\u5C01\u95ED\u524D\u8231\u95E8\u3002\u522B\u4E71\uFF0C\u7EE7\u7EED\u62A5\u544A\uFF01"
