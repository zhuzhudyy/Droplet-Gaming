      role: engineer
  - id: E034
    channel: "\u901A\u4FE1\u519B\u5B98 / CONTACT CONTROL"
    role: comms
    text: "\u6CA1\u6709\u786E\u8BA4\u3002\u8F7D\u6CE2\u5F3A\u5EA6\u7A33\u5B9A\u3002\u8FD9\u5E76\u975E\u8FDE\u63A5\u4E22\u5931\uFF0C\u53EA\u662F\u5728\u6211\u4EEC\u7406\u89E3\u7684\u9891\u7387\u4E0A\uFF0C\u59CB\u7EC8\u65E0\u4EBA\u56DE\u5E94\u3002"
    english: No acknowledgement. Carrier level is steady. This is not a lost connection;
      there is simply nobody answering on the frequencies we understand.
    time: 313.84323
    duration: 8.883
    cameraShot: 3
    stage: 3
    voice: {fileID: 8300000, guid: 7b2ee7948750dc349a92d26ac4c97d96, type: 3}
