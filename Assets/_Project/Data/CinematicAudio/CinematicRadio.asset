      duration: 7.9949164
      text: "\u6240\u6709\u70AE\u7EC4\uFF0C\u4EC5\u8DDF\u8E2A\u3002\u542F\u52A8\u5149\u675F\u524D\u786E\u8BA4\u76EE\u6807\u540E\u65B9\u7684\u8230\u4F53\u3002\u5C4F\u5E55\u91CC\u7684\u80CC\u666F\uFF0C\u662F\u53E6\u4E00\u7FA4\u8239\u5458\u3002"
