      role: commander
  narrative:
  - id: E001
    channel: "\u4E3B\u64AD / CIVIL NETWORK"
    role: anchor
    text: "\u4ECA\u591C\uFF0C\u6240\u6709\u516C\u5171\u5C4F\u5E55\u90FD\u663E\u793A\u7740\u540C\u4E00\u5E45\u753B\u9762\uFF1A\u4E00\u4E2A\u94F6\u8272\u5149\u70B9\uFF0C\u65E0\u58F0\u5730\u8D8A\u8FC7\u5916\u5C42\u8B66\u6212\u7EBF\u3002"
    english: 'Tonight, every public screen carries the same picture: a silver point,
      crossing the outer watch line without a sound.'
    time: 0
    duration: 8.707417
    cameraShot: 0
    stage: 0
    voice: {fileID: 8300000, guid: 477010b2ef11e604993c4874a4133e36, type: 3}
    premixed: 1
    captions:
    - time: 0.2
      duration: 8.207417
      text: "\u4ECA\u591C\uFF0C\u6240\u6709\u516C\u5171\u5C4F\u5E55\u90FD\u663E\u793A\u7740\u540C\u4E00\u5E45\u753B\u9762\uFF1A\u4E00\u4E2A\u94F6\u8272\u5149\u70B9\uFF0C\u65E0\u58F0\u5730\u8D8A\u8FC7\u5916\u5C42\u8B66\u6212\u7EBF\u3002"
      english: 'Tonight, every public screen carries the same picture: a silver point,
        crossing the outer watch line without a sound.'
      role: anchor
  - id: E002
    channel: "\u4E3B\u64AD / CIVIL NETWORK"
    role: anchor
    text: "\u5E02\u573A\u628A\u5B83\u79F0\u4F5C\u673A\u9047\uFF0C\u5404\u90E8\u79F0\u5B83\u4E3A\u4E8B\u4EF6\uFF1B\u5728\u591C\u534A\u7403\u89C2\u770B\u7684\u5B69\u5B50\u4EEC\uFF0C\u628A\u5B83\u53EB\u4F5C\u661F\u661F\u3002"
    english: The markets have named it an opportunity. The ministries call it an
      incident. Children watching from the night side call it a star.
    time: 8.867416
    duration: 10.330417
    cameraShot: 0
    stage: 0
    voice: {fileID: 8300000, guid: 686497eb26f589d4dbf6761aeffa42f3, type: 3}
    premixed: 1
    captions:
    - time: 0.2
      duration: 9.830417
      text: "\u5E02\u573A\u628A\u5B83\u79F0\u4F5C\u673A\u9047\uFF0C\u5404\u90E8\u79F0\u5B83\u4E3A\u4E8B\u4EF6\uFF1B\u5728\u591C\u534A\u7403\u89C2\u770B\u7684\u5B69\u5B50\u4EEC\uFF0C\u628A\u5B83\u53EB\u4F5C\u661F\u661F\u3002"
      english: The markets have named it an opportunity. The ministries call it an
        incident. Children watching from the night side call it a star.
      role: anchor
  - id: E003
    channel: "\u4E3B\u64AD / CIVIL NETWORK"
    role: anchor
    text: "\u6211\u4EEC\u5DF2\u5B66\u4F1A\u5728\u884C\u661F\u4E4B\u95F4\u5EFA\u9020\u57CE\u5E02\uFF0C\u5374\u4ECD\u5411\u964C\u751F\u8005\u63D0\u51FA\u6700\u53E4\u8001\u7684\u95EE\u9898\uFF1A\u4F60\u80FD\u7ED9\u6211\u4EEC\u4EC0\u4E48\uFF1F"
    english: 'We have learned to build cities between planets, and still we ask a
      stranger the oldest question: what can you give us?'
    time: 19.357834
    duration: 8.889417
    cameraShot: 0
    stage: 0
    voice: {fileID: 8300000, guid: 730653cf759c36f4c9be88ce4e64f4b3, type: 3}
    premixed: 1
    captions:
    - time: 0.2
      duration: 8.389417
      text: "\u6211\u4EEC\u5DF2\u5B66\u4F1A\u5728\u884C\u661F\u4E4B\u95F4\u5EFA\u9020\u57CE\u5E02\uFF0C\u5374\u4ECD\u5411\u964C\u751F\u8005\u63D0\u51FA\u6700\u53E4\u8001\u7684\u95EE\u9898\uFF1A\u4F60\u80FD\u7ED9\u6211\u4EEC\u4EC0\u4E48\uFF1F"
      english: 'We have learned to build cities between planets, and still we ask
        a stranger the oldest question: what can you give us?'
      role: anchor
  - id: E004
    channel: "\u901A\u4FE1\u519B\u5B98 / CONTACT CONTROL"
    role: comms
    text: "\u6C11\u7528\u9891\u9053\uFF0C\u8FD9\u91CC\u662F\u63A5\u89E6\u7BA1\u5236\u3002\u4F60\u4EEC\u7684\u753B\u9762\u5B58\u5728\u5EF6\u8FDF\u3002\u8BF7\u63D0\u9192\u89C2\u4F17\uFF1A\u76EE\u6807\u5C1A\u672A\u56DE\u5E94\u6211\u4EEC\u3002"
    english: Civil network, this is contact control. Your picture is delayed. Please
      remind your audience that the object has not acknowledged us.
    time: 28.407251
    duration: 8.864166
    cameraShot: 0
    stage: 0
    voice: {fileID: 8300000, guid: faa1ab0a0f4fb25489a62454cc739c36, type: 3}
    premixed: 1
    captions:
    - time: 0.2
      duration: 8.364166
      text: "\u6C11\u7528\u9891\u9053\uFF0C\u8FD9\u91CC\u662F\u63A5\u89E6\u7BA1\u5236\u3002\u4F60\u4EEC\u7684\u753B\u9762\u5B58\u5728\u5EF6\u8FDF\u3002\u8BF7\u63D0\u9192\u89C2\u4F17\uFF1A\u76EE\u6807\u5C1A\u672A\u56DE\u5E94\u6211\u4EEC\u3002"
