      role: comms
  - id: E005
    channel: "\u4E3B\u64AD / CIVIL NETWORK"
    role: anchor
    text: "\u4EBA\u4EEC\u628A\u90A3\u7247\u6C89\u9ED8\u89E3\u91CA\u6210\u81EA\u5DF1\u9700\u8981\u7684\u6A21\u6837\uFF1A\u627F\u8BFA\u3001\u5A01\u80C1\uFF0C\u6216\u662F\u5BF9\u624B\u72AF\u9519\u7684\u8BC1\u660E\u3002"
    english: That silence has become whatever people need it to be. A promise, a
      threat, a proof that their rivals were wrong.
    time: 37.43142
    duration: 7.5015416
    cameraShot: 0
    stage: 0
    voice: {fileID: 8300000, guid: c178bb26af844dc4488339b412c8177f, type: 3}
